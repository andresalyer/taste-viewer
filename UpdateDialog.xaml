<Window x:Class="Taste.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Available"
        Width="440" MinHeight="220" MaxHeight="520"
        SizeToContent="Height"
        Background="{StaticResource BgBase}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background"        Value="{StaticResource BgToolbar}"/>
            <Setter Property="Foreground"        Value="{StaticResource FgPrimary}"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Padding"           Value="16,7"/>
            <Setter Property="FontFamily"        Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"          Value="{StaticResource FontSizeMD}"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusSM}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource OverlayHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="{StaticResource Space24}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   FontFamily="{StaticResource FontPrimary}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource FgInput}"
                   Text="Taste Viewer 1.2.0 is available"/>

        <TextBlock Grid.Row="1"
                   Margin="0,4,0,16"
                   FontFamily="{StaticResource FontPrimary}"
                   FontSize="{StaticResource FontSizeSM}"
                   Foreground="{StaticResource FgSecondary}"
                   Text="What's new:"/>

        <Border Grid.Row="2"
                Background="{StaticResource BgDeep}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMD}"
                Padding="12"
                MaxHeight="280">
            <FlowDocumentScrollViewer x:Name="NotesDoc"
                                       IsToolBarVisible="False"
                                       VerticalScrollBarVisibility="Auto"
                                       Background="Transparent">
                <FlowDocument x:Name="NotesFlowDoc"
                              FontFamily="{StaticResource FontPrimary}"
                              FontSize="{StaticResource FontSizeMD}"
                              Foreground="{StaticResource FgPrimary}"
                              Background="Transparent"
                              PagePadding="0"/>
            </FlowDocumentScrollViewer>
        </Border>

        <StackPanel Grid.Row="3"
                    Margin="0,20,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Later" Margin="0,0,8,0" Click="Later_Click"/>
            <Button Content="Update Now"
                    Background="{StaticResource Accent}"
                    Foreground="White"
                    Click="UpdateNow_Click"/>
        </StackPanel>
    </Grid>
</Window>
